<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AgentMemory.Scenarios</RootNamespace>
    <AssemblyName>scenarios</AssemblyName>
    <!-- Operator tooling, not a published library. The release packs src/*/*.csproj only. -->
    <IsPackable>false</IsPackable>
    <!-- The Recommended arms run the gate (AgentMemory.Gate, experimental). -->
    <NoWarn>$(NoWarn);AMGATE001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Each run writes into a Neo4j of its own, so no run sees another's memories. -->
    <PackageReference Include="Testcontainers.Neo4j" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentMemory\AgentMemory.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Inference\AgentMemory.Inference.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Gate\AgentMemory.Gate.csproj" />
    <!-- The graph memory recalls and writes through the Agent Framework facade, as a host does. -->
    <ProjectReference Include="..\..\src\AgentMemory.AgentFramework\AgentMemory.AgentFramework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="scenarios\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="scenarios" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentMemory.Tests.Unit" />
  </ItemGroup>

</Project>
