<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AgentMemory.McpHost</RootNamespace>

    <!-- A .NET global tool: one TFM, one command name, installable with
         `dotnet tool install -g AgentMemory.McpHost`. Single-targeted deliberately - a tool package
         resolves one framework at install time, so multi-targeting it only inflates the package. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>agent-memory-mcp</ToolCommandName>
    <PackageId>AgentMemory.McpHost</PackageId>
    <PackageType>DotnetTool</PackageType>
    <Description>Turnkey MCP server for AgentMemory for .NET — runs the 27 memory tools over stdio or HTTP against Neo4j, configured entirely by environment variables. Install with `dotnet tool install -g AgentMemory.McpHost`.</Description>
    <PackageTags>agent-memory;mcp;model-context-protocol;ai;memory;neo4j;dotnet-tool</PackageTags>

    <!-- The tools shipped with no way to run them without writing a .NET host first. This is that
         host, so it is the one tools/ project that is packable. -->
    <IsPackable>true</IsPackable>

    <!-- A tool package bundles every assembly it runs, the Apache-2.0 module SDK and packs among them, so the package is
         under both licences and carries both texts and the Apache NOTICE (LICENSING.md, "Packages that bundle"). -->
    <PackageLicenseExpression>MIT AND Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="licenses/MIT/" Visible="false" />
    <None Include="..\..\src\AgentMemory.Extensibility\LICENSE" Pack="true" PackagePath="licenses/Apache-2.0/" Visible="false" />
    <None Include="..\..\src\AgentMemory.Extensibility\NOTICE" Pack="true" PackagePath="licenses/Apache-2.0/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <EmbeddedResource Include="Coding/Page/*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Option parsing is the part most likely to be quietly wrong and least likely to be caught by
         running the server, so it is unit-tested directly rather than through reflection. -->
    <InternalsVisibleTo Include="AgentMemory.Tests.Unit" />
    <InternalsVisibleTo Include="AgentMemory.Tests.Integration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentMemory.McpServer\AgentMemory.McpServer.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Core\AgentMemory.Core.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Neo4j\AgentMemory.Neo4j.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Extraction.Llm\AgentMemory.Extraction.Llm.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Gate\AgentMemory.Gate.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentMemory.Inference\AgentMemory.Inference.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in memory packs for coding mode (Extensibility 0.13 §M). Bundled in the tool package, so no NuGet dependency on the
         preview line; those projects keep their own version even when the release passes -p:Version (TreatAsLocalProperty). -->
    <ProjectReference Include="..\..\src\AgentMemory.Extensibility\AgentMemory.Extensibility.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Extensibility.Neo4j\AgentMemory.Extensibility.Neo4j.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Packs.Repository\AgentMemory.Packs.Repository.csproj" />
    <!-- KP-composite: the Coding composite (decisions, repository, code map); held packages that ship inside this tool. -->
    <ProjectReference Include="..\..\src\AgentMemory.Packs.Coding\AgentMemory.Packs.Coding.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Packs.Architecture\AgentMemory.Packs.Architecture.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Packs.Intent\AgentMemory.Packs.Intent.csproj" />
  </ItemGroup>

</Project>
