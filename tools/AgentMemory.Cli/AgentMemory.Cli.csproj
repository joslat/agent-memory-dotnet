<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AgentMemory.Cli</RootNamespace>
    <!-- Operator tooling, not a published library. The release packs src/*/*.csproj only. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Meta-package (Abstractions + Core + Neo4j + Extraction.Llm + Observability + Enrichment +
         Extraction.AzureLanguage) — transitively exposes IMigrationRunner / ISchemaBootstrapper /
         IConsolidationService / IMemoryDecayService and the rest of the memory services. -->
    <ProjectReference Include="..\..\src\AgentMemory\AgentMemory.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentMemory.Tests.Unit" />
  </ItemGroup>

</Project>
