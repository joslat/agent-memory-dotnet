<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Apache-2.0 from 2.0.0: this project practises the ampack format or its host procedure; see PATENTS.md at the repository root. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!-- `ampack`: build, sign, verify, inspect and test memory packs (strategy PACK-tool, PACK-toolset). Published as one
       self-contained file per platform (dotnet publish with a runtime identifier, self-contained, PublishSingleFile), so a pack author
       needs no .NET. Not NativeAOT: `ampack test` runs packs on the SDK's in-memory engine, which uses reflection-based JSON;
       NativeAOT returns when the SDK is AOT-compatible. `dotnet run` works for development. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Ampack</AssemblyName>
    <RootNamespace>Ampack</RootNamespace>
    <!-- The tool is first-party: it uses the preview pack host API (AMEXT001) on purpose. -->
    <NoWarn>$(NoWarn);AMEXT001</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- dpapi keys (keygen with protection, and key paths that start with dpapi:): a private key encrypted for the Windows user. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <!-- Ed25519 for .mem bundles (feature 15): their signatures are checked and theirs are written. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentMemory.Packs.Format\AgentMemory.Packs.Format.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Extensibility.Ampack\AgentMemory.Extensibility.Ampack.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Packs.Solid\AgentMemory.Packs.Solid.csproj" />
  </ItemGroup>
</Project>
