<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>AgentMemory.TckBridge.Nams</RootNamespace>
    <!-- Operator/conformance tooling, not a published library. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- NAMS backend only, no Core/Neo4j/meta-package reference, unlike the direct-backend bridge. -->
    <ProjectReference Include="..\..\src\AgentMemory.Nams\AgentMemory.Nams.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unlike the direct-backend AgentMemory.TckBridge (whose Dtos.cs records are public, needing no
         grant), these DTOs are deliberately internal, so the wire-contract unit test needs its own grant. -->
    <InternalsVisibleTo Include="AgentMemory.Tests.Unit" />
  </ItemGroup>

</Project>
