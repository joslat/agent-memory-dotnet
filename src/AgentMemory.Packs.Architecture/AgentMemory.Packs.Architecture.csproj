<!-- TreatAsLocalProperty: a host that bundles this project is packed with -p:Version=<core>; the global property must not
     restamp this line's own version, or the SDK and module versions would no longer match. -->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="Version">

  <PropertyGroup>
    <RootNamespace>AgentMemory.Packs.Architecture</RootNamespace>
    <AssemblyName>AgentMemory.Packs.Architecture</AssemblyName>
    <Description>Experimental architecture memory pack for AgentMemory for .NET: a project's systems, components, APIs and their operations, dependencies and owners, read deterministically from Backstage catalogs, OpenAPI and AsyncAPI documents, CycloneDX and SPDX SBOMs and Structurizr workspaces.</Description>
    <PackageTags>agent-memory;memory-pack;coding;architecture;openapi;asyncapi;sbom;backstage;c4</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The module's own version: the embedded manifest names the same, and ModuleManifest.Load refuses a mismatch. -->
    <Version>0.1.0-preview.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentMemory.Extensibility\AgentMemory.Extensibility.csproj" />
    <!-- YAML is how most OpenAPI documents and every Backstage catalog are written; the dependency stays in this pack. -->
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="manifest.json" LogicalName="AgentMemory.Packs.Architecture.agentmemory-module.json" />
    <InternalsVisibleTo Include="AgentMemory.Tests.Unit.Extensibility" />
  </ItemGroup>

</Project>
