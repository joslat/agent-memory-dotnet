<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Convenience meta-package for Neo4j Agent Memory. References all essential assemblies so consumers only need a single package reference.</Description>
    <Authors>Neo4j</Authors>
    <PackageTags>neo4j;agent-memory;ai;llm;memory;graphrag</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentMemory.Abstractions\AgentMemory.Abstractions.csproj" />
    <ProjectReference Include="..\AgentMemory.Core\AgentMemory.Core.csproj" />
    <ProjectReference Include="..\AgentMemory.Neo4j\AgentMemory.Neo4j.csproj" />
    <ProjectReference Include="..\AgentMemory.Extraction.Llm\AgentMemory.Extraction.Llm.csproj" />
    <!-- Optional capabilities, wired via the opt-in WithObservability/WithEnrichment/WithAzureLanguageExtraction methods. -->
    <ProjectReference Include="..\AgentMemory.Observability\AgentMemory.Observability.csproj" />
    <ProjectReference Include="..\AgentMemory.Enrichment\AgentMemory.Enrichment.csproj" />
    <ProjectReference Include="..\AgentMemory.Extraction.AzureLanguage\AgentMemory.Extraction.AzureLanguage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
  </ItemGroup>

</Project>
