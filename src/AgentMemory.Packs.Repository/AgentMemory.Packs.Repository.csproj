<!-- TreatAsLocalProperty: a host that bundles this project (the coding tool) is packed with -p:Version=<core>; the
     global property must not restamp this line's own version, or the SDK and module versions would no longer match. -->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="Version">

  <PropertyGroup>
    <!-- Apache-2.0 from 2.0.0: this project practises the ampack format or its host procedure; see PATENTS.md at the repository root. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <RootNamespace>AgentMemory.Packs.Repository</RootNamespace>
    <AssemblyName>AgentMemory.Packs.Repository</AssemblyName>
    <Description>Experimental repository-experience memory pack for AgentMemory for .NET: what a coding agent learns in a repository (failure and fix, commands, conventions, pitfalls, environment), bound to the commit it was seen at. A code module on the Extensibility preview SDK.</Description>
    <PackageTags>agent-memory;memory-pack;coding;repository;lessons</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The module's own version: the embedded manifest names the same, and ModuleManifest.Load refuses a mismatch. -->
    <Version>0.1.0-preview.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentMemory.Extensibility\AgentMemory.Extensibility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="manifest.json" LogicalName="AgentMemory.Packs.Repository.agentmemory-module.json" />
    <InternalsVisibleTo Include="AgentMemory.Tests.Unit.Extensibility" />
  </ItemGroup>

</Project>
