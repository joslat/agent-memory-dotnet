<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AgentMemory.McpServer.Nams</RootNamespace>
    <Description>MCP server tools for the NAMS backend of AgentMemory for .NET -- opt-in, capability-aware, never part of the automatic recall/persistence lifecycle.</Description>
    <PackageTags>agent-memory;mcp;model-context-protocol;nams;neo4j</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.8.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentMemory.Nams\AgentMemory.Nams.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentMemory.Tests.Unit" />
  </ItemGroup>

</Project>
