<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\AgentMemory.Abstractions\AgentMemory.Abstractions.csproj" />
    <ProjectReference Include="..\AgentMemory.Core\AgentMemory.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
  </ItemGroup>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>LLM-based structured extraction backend for AgentMemory for .NET — extracts entities, relationships, facts, and preferences from conversations.</Description>
    <PackageTags>agent-memory;extraction;llm;ai;memory;neo4j</PackageTags>
    <!-- The store-aware writer seam (IMemoryWriter) is experimental (AMWRITE001); this package implements it. -->
    <NoWarn>$(NoWarn);AMWRITE001;AMGATE001;AMDREAM001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AgentMemory.Tests.Unit" />
    <InternalsVisibleTo Include="AgentMemory.LongMemEval" />
    <InternalsVisibleTo Include="AgentMemory.Tests.Unit.LongMemEval" />
  </ItemGroup>

</Project>
