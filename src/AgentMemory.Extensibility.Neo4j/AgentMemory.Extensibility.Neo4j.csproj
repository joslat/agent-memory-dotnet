<!-- TreatAsLocalProperty: a host that bundles this project (the coding tool) is packed with -p:Version=<core>; the
     global property must not restamp this line's own version, or the SDK and module versions would no longer match. -->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="Version">

  <PropertyGroup>
    <!-- Apache-2.0 from 2.0.0: this project implements the ampack format or its host procedure; see PATENTS.md at the repository root. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
  <PropertyGroup>
    <RootNamespace>AgentMemory.Extensibility.Neo4j</RootNamespace>
    <Description>Experimental Neo4j storage and migration adapter for AgentMemory modules.</Description>
    <PackageTags>agent-memory;memory;extensibility;neo4j</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>0.2.0</Version>
    <!-- The preview line's release version (40.27): a preview-v tag passes it, so the core projects this one references
         keep their own version and the package's dependencies stay real. -->
    <Version Condition="'$(PreviewVersion)' != ''">$(PreviewVersion)</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- The scoped reader consumes the host isolation contract directly, never Core. -->
    <ProjectReference Include="../AgentMemory.Abstractions/AgentMemory.Abstractions.csproj" />
    <ProjectReference Include="../AgentMemory.Extensibility/AgentMemory.Extensibility.csproj" />
    <ProjectReference Include="../AgentMemory.Neo4j/AgentMemory.Neo4j.csproj" />
    <InternalsVisibleTo Include="AgentMemory.Tests.Unit.Extensibility" />
    <InternalsVisibleTo Include="AgentMemory.Tests.Integration" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../shared/AdditiveMigrationLint.cs" Link="Shared/AdditiveMigrationLint.cs" />
    <Compile Include="../../shared/ModuleBookkeepingSchema.cs" Link="Shared/ModuleBookkeepingSchema.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../shared/ManagedEmbeddedResources.cs" Link="Shared/ManagedEmbeddedResources.cs" />
  </ItemGroup>
</Project>
