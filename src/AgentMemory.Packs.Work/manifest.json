{
  "format": "agentmemory.module/v1alpha1",
  "id": "io.agentmemory.packs.work",
  "version": "0.1.0-preview.1",
  "sdk": "[0.1,0.2)",
  "requires": {
    "modules": {
      "io.agentmemory.packs.codemap": "[0.1.0-preview.1,0.2)"
    }
  },
  "display": {
    "title": "Work",
    "description": "What was planned and done: the project's work items, each linked to the source files its commits changed. It lets memory say what work last shaped the code in hand.",
    "color": "#8F6200"
  },
  "ontology": {
    "labelPrefix": "Work",
    "types": [
      {
        "name": "WorkItem",
        "scope": "shared",
        "description": "One planned piece of work: what it is, where it stands and why it was asked for.",
        "render": "Work item {item} ({status}): {title}. {summary}",
        "properties": {
          "item": { "type": "string", "required": true, "maxLength": 64, "indexed": true, "description": "The item's id in its ledger" },
          "title": { "type": "string", "required": true, "maxLength": 300 },
          "status": { "type": "string", "required": true, "maxLength": 32 },
          "phase": { "type": "string", "maxLength": 200 },
          "summary": { "type": "string", "maxLength": 1200, "description": "The start of the item's notes: usually who asked for it and why" },
          "remaining": { "type": "string", "maxLength": 64 },
          "actual": { "type": "string", "maxLength": 64 },
          "checkpoint": { "type": "string", "maxLength": 120 },
          "commits": { "type": "int", "min": 0 },
          "source": { "type": "string", "required": true, "maxLength": 512, "description": "The ledger file and item it came from" }
        }
      }
    ],
    "relations": [
      {
        "name": "WORK_CHANGED",
        "from": "WorkItem",
        "to": "io.agentmemory.packs.codemap:CodemapFile",
        "max": 64,
        "description": "A source file a commit of this work item changed"
      }
    ]
  },
  "traversal": {
    "relations": [
      { "name": "WORK_CHANGED", "direction": "in", "weight": 0.6, "fanOut": 3 }
    ],
    "maxItems": 2,
    "hops": 1
  }
}
