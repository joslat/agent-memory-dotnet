<!-- TreatAsLocalProperty: a host that bundles this project is packed with -p:Version=<core>; the global property must not
     restamp this line's own version, or the SDK and module versions would no longer match. -->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="Version">

  <PropertyGroup>
    <!-- Apache-2.0 from 2.0.0: this project practises the ampack format or its host procedure; see PATENTS.md at the repository root. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <RootNamespace>AgentMemory.Packs.Work</RootNamespace>
    <AssemblyName>AgentMemory.Packs.Work</AssemblyName>
    <Description>Experimental work memory pack for AgentMemory for .NET: a project's work items from its task ledger, each linked to the source files its commits changed, so traversal context can say what work last shaped the code in hand. Sits under decisions and over the code map in the Coding family.</Description>
    <PackageTags>agent-memory;memory-pack;coding;work;tasks</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The module's own version: the embedded manifest names the same, and ModuleManifest.Load refuses a mismatch. -->
    <Version>0.1.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentMemory.Packs.CodeMap\AgentMemory.Packs.CodeMap.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="manifest.json" LogicalName="AgentMemory.Packs.Work.agentmemory-module.json" />
    <InternalsVisibleTo Include="AgentMemory.Tests.Unit.Extensibility" />
  </ItemGroup>

</Project>
