<!-- TreatAsLocalProperty: a host that bundles this project is packed with -p:Version=<core>; the global property must not
     restamp this line's own version, or the SDK and module versions would no longer match. -->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="Version">

  <PropertyGroup>
    <RootNamespace>AgentMemory.Packs.Decisions</RootNamespace>
    <AssemblyName>AgentMemory.Packs.Decisions</AssemblyName>
    <Description>Experimental decisions memory pack for AgentMemory for .NET: what was decided in a project, why, its status and the code it applies to, read deterministically from ADR and MADR files and Squad's decision log.</Description>
    <PackageTags>agent-memory;memory-pack;coding;decisions;adr</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The module's own version: the embedded manifest names the same, and ModuleManifest.Load refuses a mismatch. -->
    <Version>0.1.0-preview.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentMemory.Extensibility\AgentMemory.Extensibility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="manifest.json" LogicalName="AgentMemory.Packs.Decisions.agentmemory-module.json" />
    <InternalsVisibleTo Include="AgentMemory.Tests.Unit.Extensibility" />
  </ItemGroup>

</Project>
