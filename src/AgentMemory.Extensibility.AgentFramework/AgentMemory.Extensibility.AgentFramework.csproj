<!-- TreatAsLocalProperty: a host that bundles this project (the coding tool) is packed with -p:Version=<core>; the
     global property must not restamp this line's own version, or the SDK and module versions would no longer match. -->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="Version">

  <PropertyGroup>
    <!-- Apache-2.0 from 2.0.0: this project implements the ampack format or its host procedure; see PATENTS.md at the repository root. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgentMemory.Extensibility.AgentFramework</RootNamespace>
    <AssemblyName>AgentMemory.Extensibility.AgentFramework</AssemblyName>
    <Description>Microsoft Agent Framework surface for the AgentMemory module SDK: an AIContextProvider that composes the shipped provider and appends module sections. Experimental, 0.x line.</Description>
    <PackageTags>agent-memory;ai;llm;memory;extensibility;agent-framework;maf</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.2.0</Version>
    <!-- The preview line's release version (40.27): a preview-v tag passes it, so the core projects this one references
         keep their own version and the package's dependencies stay real. -->
    <Version Condition="'$(PreviewVersion)' != ''">$(PreviewVersion)</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- A LAYERED ADAPTER: this adapter depends on another adapter, which docs/architecture.md 2.2
         says does not happen. The precedent is AgentMemory.AgentFramework.Nams, and the reason is
         the same here: the whole point of this package is to COMPOSE the shipped MAF provider rather
         than re-implement it, so it must reference it. The 2.2 clause is updated in this PR rather
         than the exception being left silent. -->
    <ProjectReference Include="..\AgentMemory.Extensibility\AgentMemory.Extensibility.csproj" />
    <ProjectReference Include="..\AgentMemory.AgentFramework\AgentMemory.AgentFramework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentMemory.Tests.Unit.Extensibility" />
  </ItemGroup>

</Project>
