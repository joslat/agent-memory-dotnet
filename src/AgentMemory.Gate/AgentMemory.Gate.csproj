<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgentMemory.Gate</RootNamespace>
    <AssemblyName>AgentMemory.Gate</AssemblyName>
    <Description>Configured retrieval and storage judging for AgentMemory for .NET. Judges each recalled memory and proposed replacement through System One endpoints (online or local), with explicit fallback and diagnostic traces. Ordinary gate contracts are stable; optional compound-question planning remains experimental.</Description>
    <PackageTags>agent-memory;ai;llm;memory;retrieval;gate;router</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Compound-question planning remains experimental inside the module. -->
    <NoWarn>$(NoWarn);AMGATE001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- ABSTRACTIONS ONLY: the gate decorates IMemoryContextAssembler and implements IMemoryGate and IMemoryUpdateJudge,
         all Abstractions interfaces, so it runs over any store. -->
    <ProjectReference Include="..\AgentMemory.Abstractions\AgentMemory.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <!-- AddAgentMemoryGate(IConfiguration): the settings from a configuration section (AgentMemory:RetrievalRouter). -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentMemory.Tests.Unit" />
    <!-- The fixed-pool evaluation invokes the same internal coordinator rather than copying its policy. -->
    <InternalsVisibleTo Include="router-arena" />
  </ItemGroup>

</Project>
