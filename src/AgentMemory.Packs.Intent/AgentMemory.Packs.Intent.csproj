<!-- TreatAsLocalProperty: a host that bundles this project is packed with -p:Version=<core>; the global property must not
     restamp this line's own version, or the SDK and module versions would no longer match. -->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="Version">

  <PropertyGroup>
    <!-- Apache-2.0 from 2.0.0: this project practises the ampack format or its host procedure; see PATENTS.md at the repository root. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <RootNamespace>AgentMemory.Packs.Intent</RootNamespace>
    <AssemblyName>AgentMemory.Packs.Intent</AssemblyName>
    <Description>Experimental product intent memory pack for AgentMemory for .NET: requirements in EARS form, the Gherkin scenarios that pin them down, OpenSLO service level objectives and product ideas, read deterministically from the repository.</Description>
    <PackageTags>agent-memory;memory-pack;coding;requirements;ears;gherkin;openslo</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The module's own version: the embedded manifest names the same, and ModuleManifest.Load refuses a mismatch. -->
    <Version>0.1.0-preview.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentMemory.Extensibility\AgentMemory.Extensibility.csproj" />
    <!-- OpenSLO documents are YAML; the dependency stays in this pack. -->
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="manifest.json" LogicalName="AgentMemory.Packs.Intent.agentmemory-module.json" />
    <InternalsVisibleTo Include="AgentMemory.Tests.Unit.Extensibility" />
  </ItemGroup>

</Project>
