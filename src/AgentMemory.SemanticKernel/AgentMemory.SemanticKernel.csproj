<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Semantic Kernel adapter for AgentMemory for .NET, a Neo4j-backed agent-memory library.</Description>
    <PackageTags>neo4j;agent-memory;semantic-kernel;ai;rag</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AgentMemory.Tests.Unit.SemanticKernel" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AgentMemory.Abstractions\AgentMemory.Abstractions.csproj" />
    <ProjectReference Include="..\AgentMemory.Core\AgentMemory.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.79.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
  </ItemGroup>
</Project>
