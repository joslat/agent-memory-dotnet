<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="Version">

  <PropertyGroup>
    <!-- Apache-2.0 from 2.0.0: this project practises the ampack format or its host procedure; see PATENTS.md at the repository root. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <RootNamespace>AgentMemory.Packs.Coding</RootNamespace>
    <AssemblyName>AgentMemory.Packs.Coding</AssemblyName>
    <Description>Experimental composite memory pack for AgentMemory for .NET: one pack made of the decisions, repository-experience, code map and work packs, with their priorities and hierarchy, so a coding host adds what governs the code in one call.</Description>
    <PackageTags>agent-memory;memory-pack;coding;composite</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>0.1.0-preview.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentMemory.Packs.Decisions\AgentMemory.Packs.Decisions.csproj" />
    <ProjectReference Include="..\AgentMemory.Packs.Repository\AgentMemory.Packs.Repository.csproj" />
    <ProjectReference Include="..\AgentMemory.Packs.CodeMap\AgentMemory.Packs.CodeMap.csproj" />
    <ProjectReference Include="..\AgentMemory.Packs.Work\AgentMemory.Packs.Work.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="composite.json" LogicalName="AgentMemory.Packs.Coding.agentmemory-composite.json" />
  </ItemGroup>

</Project>
