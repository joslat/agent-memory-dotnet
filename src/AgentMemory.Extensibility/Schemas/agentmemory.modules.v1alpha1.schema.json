{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/joslat/agent-memory-dotnet/main/src/AgentMemory.Extensibility/Schemas/agentmemory.modules.v1alpha1.schema.json",
  "title": "AgentMemory modules v1alpha1",
  "description": "Host/CLI profile shape only. Runtime reconciliation, actual service probes and verified activation are still required.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "agentmemory.modules/v1alpha1"
    },
    "stores": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/localId"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "$ref": "#/$defs/localId"
          }
        },
        "required": [
          "provider"
        ]
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "required": [
    "format",
    "stores",
    "modules"
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){2,})(?![\\s\\S])",
      "maxLength": 64
    },
    "localId": {
      "type": "string",
      "pattern": "^(?:[A-Za-z][A-Za-z0-9._-]*)(?![\\s\\S])",
      "maxLength": 64
    },
    "label": {
      "type": "string",
      "pattern": "^(?:[A-Z][A-Za-z0-9]*)(?![\\s\\S])"
    },
    "propertyName": {
      "type": "string",
      "pattern": "^(?:[A-Za-z][A-Za-z0-9_]*)(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)(?![\\s\\S])"
    },
    "range": {
      "type": "string",
      "pattern": "^(?:\\s*(?:(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?|\\[\\s*(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?\\s*\\]|(?:\\[|\\()\\s*(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?\\s*,\\s*(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?\\s*(?:\\]|\\))|\\(\\s*,\\s*(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?\\s*(?:\\]|\\))|(?:\\[|\\()\\s*(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?\\s*,\\s*\\)|\\(\\s*,\\s*\\))\\s*)(?![\\s\\S])",
      "description": "SemVer interval syntax; runtime checks ordering and nonempty bounds."
    },
    "positiveInt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "source": {
      "$ref": "#/$defs/text",
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/moduleId"
        },
        "version": {
          "$ref": "#/$defs/range"
        },
        "store": {
          "$ref": "#/$defs/localId"
        },
        "assembly": {
          "$ref": "#/$defs/source"
        },
        "manifest": {
          "$ref": "#/$defs/source"
        },
        "configuration": {
          "type": "string",
          "pattern": "^(?:[^:\\u0000-\\u001f\\u007f-\\u009f]*[^\\s:\\u0000-\\u001f\\u007f-\\u009f][^:\\u0000-\\u001f\\u007f-\\u009f]*(?::[^:\\u0000-\\u001f\\u007f-\\u009f]*[^\\s:\\u0000-\\u001f\\u007f-\\u009f][^:\\u0000-\\u001f\\u007f-\\u009f]*)*)(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^(?:[0-9a-fA-F]{64})(?![\\s\\S])"
        }
      },
      "required": [
        "id",
        "version",
        "store"
      ],
      "oneOf": [
        {
          "required": [
            "assembly"
          ],
          "not": {
            "required": [
              "manifest"
            ]
          }
        },
        {
          "required": [
            "manifest"
          ],
          "not": {
            "required": [
              "assembly"
            ]
          }
        }
      ]
    }
  }
}
