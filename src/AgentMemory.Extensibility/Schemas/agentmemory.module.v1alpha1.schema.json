{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/joslat/agent-memory-dotnet/main/src/AgentMemory.Extensibility/Schemas/agentmemory.module.v1alpha1.schema.json",
  "title": "AgentMemory module v1alpha1",
  "description": "Editor shape validation only. Call Parse, Validate and Resolve for ownership, references, bounds and host/trust checks.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "agentmemory.module/v1alpha1"
    },
    "id": {
      "$ref": "#/$defs/moduleId"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "sdk": {
      "$ref": "#/$defs/range"
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modules": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/moduleId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/range"
          }
        },
        "host": {
          "type": "array",
          "items": {
            "enum": [
              "History",
              "Reminders",
              "Inference"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "ontology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labelPrefix": {
          "$ref": "#/$defs/label"
        },
        "types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/type"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          }
        }
      },
      "required": [
        "labelPrefix"
      ]
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "seed": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "description": "Knowledge pack seed record files (.jsonl), relative to the bundle root. A manifest with seed files declares only shared types, no host features and no dependencies.",
      "items": {
        "type": "string",
        "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,99}/){0,7}[A-Za-z0-9][A-Za-z0-9._-]{0,99}\\.jsonl(?![\\s\\S])"
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "description": "How a host shows the module or pack: shown to people, never to a model. An icon is allowed only in a knowledge pack bundle.",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "icon": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,99}/){0,7}[A-Za-z0-9][A-Za-z0-9._-]{0,99}\\.png(?![\\s\\S])"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}(?![\\s\\S])"
        }
      }
    },
    "containableBy": {
      "type": "array",
      "description": "The modules allowed to walk into this one's records through their own links, by module id or parent namespace. Empty or absent: none may.",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "uniqueItems": true
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "description": "The trial a host runs on its own history before switching this pack on: the tasks it draws, and targets every one of which must be met. Enforced only by a host that requires trials.",
      "required": ["measure", "targets"],
      "properties": {
        "measure": { "enum": ["test-impact"] },
        "tasks": { "type": "integer", "minimum": 10, "maximum": 200 },
        "baseline": { "enum": ["host", "none"] },
        "confidence": { "enum": [0.9, 0.95, 0.975, 0.99] },
        "upgrade": {
          "type": "object",
          "additionalProperties": false,
          "description": "The upgrade rule: a new version goes on only if, on the same tasks in the same run, its hit rate and precision drop by at most the tolerance against the version active before it.",
          "required": ["noRegression"],
          "properties": {
            "noRegression": { "type": "boolean" },
            "tolerance": { "type": "number", "minimum": 0, "maximum": 0.5 }
          }
        },
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "hitRate": { "type": "number", "minimum": 0, "maximum": 1 },
            "precision": { "type": "number", "minimum": 0, "maximum": 1 },
            "lift": { "type": "number", "minimum": -1, "maximum": 1 },
            "precisionLift": { "type": "number", "minimum": -1, "maximum": 1 },
            "addedP95Ms": { "type": "number", "exclusiveMinimum": 0, "maximum": 60000 }
          }
        }
      }
    },
    "traversal": {
      "type": "object",
      "additionalProperties": false,
      "description": "How the module joins traversal context: which of its records a turn's anchors (the file or symbol in hand) match, which of its own links a walk may follow, and how many of the records reached it offers to the gate. It declares at least one anchor or one relation; anchors are unique by (type, property), relations by (name, direction), and the validator checks that they name owned types, string properties and owned relations.",
      "minProperties": 1,
      "anyOf": [
        { "required": ["anchors"], "properties": { "anchors": { "minItems": 1 } } },
        { "required": ["relations"], "properties": { "relations": { "minItems": 1 } } }
      ],
      "properties": {
        "anchors": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "property"
            ],
            "properties": {
              "type": {
                "$ref": "#/$defs/label"
              },
              "property": {
                "$ref": "#/$defs/propertyName"
              },
              "match": {
                "enum": [
                  "exact",
                  "prefix",
                  "glob",
                  "name"
                ],
                "description": "exact: equals the anchor; prefix: a folder that contains it; glob: patterns (* and **) that match it; name: a symbol's simple name or SCIP identity. Prefix and glob values may hold several, split by whitespace, ',' or ';'."
              },
              "kind": {
                "enum": [
                  "path",
                  "symbol"
                ],
                "description": "Which anchors the property is compared with; path when omitted."
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^(?:[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*)(?![\\s\\S])",
                "description": "An owned relationship."
              },
              "direction": {
                "enum": [
                  "out",
                  "in"
                ],
                "description": "out follows the link from its source; in finds the sources that point at a record."
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1,
                "description": "How much of a record's score passes along the link; 0.8 when omitted."
              },
              "fanOut": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32,
                "description": "Most records one record leads to; 8 when omitted."
              }
            }
          }
        },
        "hubs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/label"
          },
          "description": "Owned types a walk passes through but never offers, such as files."
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "description": "Most records offered for one turn; 4 when omitted."
        },
        "hops": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "Most links followed from an anchor; 2 when omitted."
        }
      }
    }
  },
  "required": [
    "format",
    "id",
    "version",
    "sdk"
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){2,})(?![\\s\\S])",
      "maxLength": 64
    },
    "localId": {
      "type": "string",
      "pattern": "^(?:[A-Za-z][A-Za-z0-9._-]*)(?![\\s\\S])",
      "maxLength": 64
    },
    "label": {
      "type": "string",
      "pattern": "^(?:[A-Z][A-Za-z0-9]*)(?![\\s\\S])"
    },
    "propertyName": {
      "type": "string",
      "pattern": "^(?:[A-Za-z][A-Za-z0-9_]*)(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)(?![\\s\\S])"
    },
    "range": {
      "type": "string",
      "pattern": "^(?:\\s*(?:(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?|\\[\\s*(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?\\s*\\]|(?:\\[|\\()\\s*(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?\\s*,\\s*(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?\\s*(?:\\]|\\))|\\(\\s*,\\s*(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?\\s*(?:\\]|\\))|(?:\\[|\\()\\s*(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?\\s*,\\s*\\)|\\(\\s*,\\s*\\))\\s*)(?![\\s\\S])",
      "description": "SemVer interval syntax; runtime checks ordering and nonempty bounds."
    },
    "positiveInt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "string",
            "int",
            "float",
            "bool",
            "date",
            "datetime"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "indexed": {
          "type": "boolean"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "maxLength": {
          "$ref": "#/$defs/positiveInt"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "description": {
          "$ref": "#/$defs/description"
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "values"
                ]
              },
              {
                "required": [
                  "maxLength"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "string"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "min"
                ]
              },
              {
                "required": [
                  "max"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "type": {
                "enum": [
                  "int",
                  "float"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "int"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "min": {
                "type": "integer",
                "minimum": -9223372036854775808,
                "maximum": 9223372036854775807
              },
              "max": {
                "type": "integer",
                "minimum": -9223372036854775808,
                "maximum": 9223372036854775807
              }
            }
          }
        }
      ]
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/label"
        },
        "scope": {
          "enum": [
            "owner",
            "shared"
          ],
          "default": "owner"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "color": {
          "$ref": "#/$defs/text"
        },
        "render": {
          "$ref": "#/$defs/text"
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/propertyName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/property"
          }
        }
      },
      "required": [
        "name"
      ]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^(?:[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*)(?![\\s\\S])"
        },
        "from": {
          "$ref": "#/$defs/label"
        },
        "to": {
          "type": "string",
          "pattern": "^(?:(?:[A-Z][A-Za-z0-9]*|core:Entity|[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){2,}:[A-Z][A-Za-z0-9]*))(?![\\s\\S])"
        },
        "required": {
          "type": "boolean"
        },
        "max": {
          "$ref": "#/$defs/positiveInt"
        },
        "description": {
          "$ref": "#/$defs/description"
        }
      },
      "required": [
        "name",
        "from",
        "to"
      ]
    },
    "literal": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "filter": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "$ref": "#/$defs/propertyName"
        },
        {
          "enum": [
            "=",
            "!=",
            "<",
            "<=",
            ">",
            ">=",
            "in"
          ]
        },
        {
          "anyOf": [
            {
              "$ref": "#/$defs/literal"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/literal"
              }
            }
          ]
        }
      ],
      "items": false,
      "allOf": [
        {
          "if": {
            "prefixItems": [
              true,
              {
                "const": "in"
              }
            ]
          },
          "then": {
            "prefixItems": [
              true,
              true,
              {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            ]
          },
          "else": {
            "prefixItems": [
              true,
              true,
              {
                "$ref": "#/$defs/literal"
              }
            ]
          }
        }
      ]
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "type": {
          "$ref": "#/$defs/label"
        },
        "where": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/filter"
          }
        },
        "orderBy": {
          "anyOf": [
            {
              "$ref": "#/$defs/propertyName"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "property": {
                  "$ref": "#/$defs/propertyName"
                },
                "descending": {
                  "type": "boolean"
                }
              },
              "required": [
                "property"
              ]
            }
          ]
        },
        "limit": {
          "$ref": "#/$defs/positiveInt"
        },
        "selection": {
          "type": "string",
          "enum": [
            "snapshot",
            "history"
          ],
          "default": "snapshot",
          "description": "History requires an exact runtime key and uses fixed newest-version-first order."
        },
        "search": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "properties"
          ],
          "description": "Full-text search over declared string properties: results are ordered by score, current records only, at most 24.",
          "properties": {
            "properties": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/propertyName"
              }
            }
          }
        }
      },
      "required": [
        "id",
        "type",
        "limit"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "selection": {
                "const": "history"
              }
            },
            "required": [
              "selection"
            ]
          },
          "then": {
            "not": {
              "required": [
                "orderBy"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "search"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "orderBy"
                  ]
                },
                {
                  "properties": {
                    "selection": {
                      "const": "history"
                    }
                  },
                  "required": [
                    "selection"
                  ]
                },
                {
                  "properties": {
                    "limit": {
                      "minimum": 25
                    }
                  },
                  "required": [
                    "limit"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
