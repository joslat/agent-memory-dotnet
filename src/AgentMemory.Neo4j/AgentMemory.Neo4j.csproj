<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AgentMemory.Abstractions\AgentMemory.Abstractions.csproj" />
    <ProjectReference Include="..\AgentMemory.Core\AgentMemory.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageReference Include="Neo4j.Driver" Version="6.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Neo4j persistence and retrieval for AgentMemory for .NET — repositories, schema bootstrapper, and GraphRAG retrievers (vector, fulltext, hybrid, graph).</Description>
    <PackageTags>agent-memory;neo4j;graphrag;memory;ai</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentMemory.Tests.Unit" />
    <InternalsVisibleTo Include="AgentMemory.Tests.Integration" />
  </ItemGroup>

  <!-- Cypher migration scripts must ship next to the assembly so MigrationRunner can
       discover them under AppContext.BaseDirectory/Schema/Migrations at runtime. -->
  <ItemGroup>
    <Content Include="Schema\Migrations\*.cypher" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Frozen upstream schema snapshots embedded for the parity compatibility kit (TCK). The canonical
       capture lives under Schema/Parity/Snapshots; embedding it (single source of truth) lets
       SchemaParityVerifier and the `agentmemory schema-parity` CLI self-verify with no external path
       dependency. Add a new version by dropping its schema.json and adding an <EmbeddedResource> with
       the matching LogicalName. -->
  <ItemGroup>
    <EmbeddedResource Include="Schema\Parity\Snapshots\python-v0.5.0\schema.json">
      <LogicalName>AgentMemory.Neo4j.Schema.Parity.Snapshots.0.5.0.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
