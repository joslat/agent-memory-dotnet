    {
      "id": "embeddings.query-text-is-embedded-through-the-endpoint",
      "tier": "B",
      "stubs": true,
      "source": "native/gate/tests/test_gate.py::Test6Embeddings::test_query_text_is_embedded_through_the_endpoint",
      "note": "Neo4j vector scores are (1 + cosine) / 2: an unrelated (orthogonal) item scores exactly 0.5.",
      "steps": [
        {
          "open": {
            "config": {
              "$config": "readEmbedding"
            }
          },
          "expect": {
            "status": "OK"
          }
        },
        {
          "call": {
            "request": {
              "schemaVersion": 1,
              "operation": "capabilities_get"
            }
          },
          "expect": {
            "/embedding/generatesEmbeddings": true
          }
        },
        {
          "call": {
            "request": {
              "schemaVersion": 1,
              "operation": "memory_get_context",
              "sessionId": "s",
              "maxFacts": 5,
              "maxPreferences": 5,
              "query": "where do I work?",
              "minScore": 0.0
            }
          },
          "expect": {
            "status": "ok",
            "/facts/0/id": "gate-fact-a-work"
          }
        },
        {
          "call": {
            "request": {
              "schemaVersion": 1,
              "operation": "memory_get_context",
              "sessionId": "s",
              "maxFacts": 5,
              "maxPreferences": 5,
              "query": "how should answers sound?",
              "minScore": 0.75
            }
          },
          "expect": {
            "$ids": [
              "gate-pref-a-concise"
            ]
          }
        },
        {
          "stub": {
            "seen": true
          },
          "expect": {
            "/embeddings/0/model": "gate-unit-axes",
            "/embeddings/0/input": [
              "where do I work?"
            ],
            "/embeddings/0/authorization": "Bearer gate-key"
          }
        },
        {
          "close": {},
          "expect": {
            "status": "OK"
          }
        }
      ]
    },
