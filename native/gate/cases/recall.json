    {
      "id": "lifecycle.timeout-retires-the-result",
      "tier": "B",
      "source": "native/gate/tests/test_gate.py::Test5Lifecycle::test_timeout_retires_the_result",
      "note": "1 ms is shorter than a recall almost everywhere; a fast runner can finish one in time, so it is tried until one runs out.",
      "steps": [
        {
          "open": {
            "config": {
              "$config": "read"
            }
          },
          "expect": {
            "status": "OK"
          }
        },
        {
          "repeat": {
            "times": 50,
            "step": {
              "call": {
                "request": {
                  "schemaVersion": 1,
                  "operation": "memory_get_context",
                  "sessionId": "s",
                  "maxFacts": 5,
                  "maxPreferences": 5,
                  "queryVector": {
                    "$vector": "near_axis_0"
                  }
                },
                "timeoutMs": 1
              }
            },
            "until": {
              "status": {
                "$not": "ok"
              }
            }
          },
          "expect": {
            "status": "timeout",
            "error": {
              "code": "timeout"
            }
          }
        },
        {
          "close": {},
          "expect": {
            "status": "OK"
          }
        }
      ]
    },
    {
      "id": "lifecycle.cancel-then-release-then-the-handle-is-dead",
      "tier": "B",
      "source": "native/gate/tests/test_gate.py::Test5Lifecycle::test_cancel_then_release_then_the_handle_is_dead",
      "steps": [
        {
          "open": {
            "config": {
              "$config": "read"
            }
          },
          "expect": {
            "status": "OK"
          }
        },
        {
          "submit": {
            "request": {
              "schemaVersion": 1,
              "operation": "memory_get_context",
              "sessionId": "s",
              "maxFacts": 5,
              "maxPreferences": 5,
              "queryVector": {
                "$vector": "near_axis_0"
              }
            },
            "timeoutMs": 5000
          },
          "expect": {
            "status": "OK"
          }
        },
        {
          "cancel": {},
          "expect": {
            "status": "OK"
          }
        },
        {
          "await": {},
          "expect": {
            "status": {
              "$oneOf": [
                "cancelled",
                "ok"
              ]
            }
          }
        },
        {
          "release": {},
          "expect": {
            "status": "OK"
          }
        },
        {
          "poll": {},
          "expect": {
            "status": "INVALID_HANDLE"
          }
        },
        {
          "close": {},
          "expect": {
            "status": "OK"
          }
        }
      ]
