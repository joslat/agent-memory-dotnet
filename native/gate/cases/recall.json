{
  "format": "native/gate/cases/FORMAT.md",
  "description": "Tier B: recall on the seeded store (native/gate/seed/seed.cs).",
  "cases": [
    {
      "id": "recall.owned-recall-decodes-facts-preferences-and-metadata",
      "tier": "B",
      "source": "native/gate/tests/test_gate.py::Test3Recall::test_owned_recall_decodes_facts_preferences_and_metadata",
      "steps": [
        {
          "open": {
            "config": {
              "$config": "read"
            }
          },
          "expect": {
            "status": "OK"
          }
        },
        {
          "call": {
            "request": {
              "schemaVersion": 1,
              "operation": "memory_get_context",
              "sessionId": "s1",
              "maxFacts": 5,
              "maxPreferences": 5,
              "queryVector": {
                "$vector": "near_axis_0"
              },
              "minScore": 0.0,
              "requestId": "r-1"
            }
          },
          "expect": {
            "status": "ok",
            "requestId": "r-1",
            "$ids": [
              "gate-fact-a-colour",
              "gate-fact-a-work",
              "gate-pref-a-concise"
            ],
            "/facts/0/id": "gate-fact-a-work",
            "/facts/0/object": "Zurich",
            "/facts/0/metadata": {
              "$len": 0
            },
            "/facts/1/id": "gate-fact-a-colour",
            "/facts/1/metadata": {
              "trust_level": "verified",
              "source": "gate-seed",
              "count": 3,
              "ratio": 2.5,
              "flags": [
                true,
                null,
                "x"
              ],
              "nested": {
                "depth": 2,
                "label": "Zürich ✓"
              }
            },
            "/preferences/0/metadata": {
              "source": "gate-seed"
            }
          }
        },
        {
          "close": {},
          "expect": {
            "status": "OK"
          }
        }
      ]
    },
