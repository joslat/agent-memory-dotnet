    {
      "id": "contract.malformed-requests-end-as-invalid",
      "tier": "A",
      "source": "native/gate/tests/test_gate.py::Test4Contract::test_malformed_requests_end_as_invalid_without_effects",
      "steps": [
        {
          "open": {
            "config": {
              "$config": "read"
            }
          },
          "expect": {
            "status": "OK"
          }
        },
        {
          "call": {
            "raw": {
              "$utf8": "{\"schemaVersion\":1,\"operation\":\"capabilities_get\",\"operation\":\"capabilities_get\"}"
            }
          },
          "expect": {
            "status": "invalid",
            "error": {
              "code": "malformed_json"
            }
          },
          "note": "a repeated key"
        },
        {
          "call": {
            "raw": {
              "schemaVersion": 1,
              "operation": "capabilities_get",
              "extra": true
            }
          },
          "expect": {
            "status": "invalid",
            "error": {
              "code": "unknown_property"
            }
          },
          "note": "an unknown property"
        },
        {
          "call": {
            "raw": {
              "schemaVersion": 2,
              "operation": "capabilities_get"
            }
          },
          "expect": {
            "status": "invalid",
            "error": {
              "code": "unsupported_schema"
            }
          },
          "note": "schema version 2"
        },
        {
          "call": {
            "raw": {
              "schemaVersion": 1,
              "operation": "memory_forget_everything"
            }
          },
          "expect": {
            "status": "invalid",
            "error": {
              "code": "unknown_operation"
            }
          },
          "note": "an unknown operation"
        },
        {
          "call": {
            "raw": {
              "$base64": "//57InNjaGVtYVZlcnNpb24iOjF9"
            }
          },
          "expect": {
            "status": "invalid",
            "error": {
              "code": "malformed_json"
            }
          },
          "note": "bytes that are not UTF-8"
        },
        {
          "call": {
            "raw": {
              "$utf8": "[1,2]"
            }
          },
          "expect": {
            "status": "invalid",
            "error": {
              "code": "not_an_object"
            }
          },
          "note": "an array"
        },
        {
          "call": {
            "raw": {
              "schemaVersion": 1,
              "operation": "memory_get_context",
              "sessionId": "s",
              "maxFacts": 5,
              "maxPreferences": 5,
              "queryVector": {
                "$vector": "three_dimensions"
              }
            }
          },
          "expect": {
            "status": "invalid",
            "error": {
              "code": "dimension_mismatch"
            }
          },
          "note": "a vector of 3"
        },
        {
          "call": {
            "raw": {
              "$utf8": "{\"schemaVersion\":1,\"operation\":\"memory_get_context\",\"sessionId\":\"s\",\"queryVector\":[1,0,0,0,0,0,0,0],\"x\":{\"a\":1,\"a\":2}}"
            }
          },
          "expect": {
            "status": "invalid",
            "error": {
              "code": "malformed_json"
            }
          },
          "note": "a repeated nested key"
        },
        {
          "call": {
            "raw": {
              "schemaVersion": 1,
              "operation": "memory_get_context",
              "sessionId": "s",
              "maxFacts": 5,
              "maxPreferences": 5,
              "queryVector": {
                "$vector": "near_axis_0"
              },
              "nested": {
                "a": 1
              }
            }
          },
          "expect": {
            "status": "invalid",
            "error": {
              "code": "unknown_property"
            }
          },
          "note": "an unknown nested property"
        },
        {
          "close": {},
          "expect": {
            "status": "OK"
          }
        }
      ]
    },
