{
  "name": "agentmemory-native",
  "version": "0.2.1",
  "description": "AgentMemory's native library for Node.js and Bun: owner-scoped recall and journaled writes over a C ABI, no .NET needed.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./langgraph": {
      "types": "./dist/src/langgraph.d.ts",
      "default": "./dist/src/langgraph.js"
    },
    "./ai": {
      "types": "./dist/src/ai.d.ts",
      "default": "./dist/src/ai.js"
    }
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"dist/test/*.test.js\"",
    "gate": "node dist/gate/runner.js"
  },
  "dependencies": {
    "koffi": "3.3.7"
  },
  "peerDependencies": {
    "@langchain/langgraph-checkpoint": "^1.2.0",
    "ai": "^7.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "peerDependenciesMeta": {
    "@langchain/langgraph-checkpoint": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "1.3.5",
    "@langchain/langgraph-checkpoint": "1.2.2",
    "@types/node": "24.19.2",
    "ai": "7.0.165",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  }
}
