# The speech-to-speech server on CPU, for tests without a robot or a GPU: Ubuntu 24.04 with the distribution's Python
# 3.12 (the same base the native library is qualified on), PyTorch's CPU build, and the server from a local checkout
# with the Kokoro text-to-speech extra. Build context: the speech-to-speech checkout, for example
#   docker build -t am-s2s-cpu:7dbbdaf -f native/speech/Dockerfile.s2s-cpu C:/git/joslat/speech-to-speech
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH="/opt/s2s/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates python3 python3-venv python3-pip libsndfile1 libportaudio2 espeak-ng \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/s2s \
    && pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cpu

WORKDIR /src
COPY . /src
RUN pip install --no-cache-dir "/src[kokoro]" \
    && pip freeze > /opt/s2s/requirements.lock.txt \
    && python -c "import nltk; nltk.download('punkt_tab'); nltk.download('averaged_perceptron_tagger_eng')"

WORKDIR /work
EXPOSE 8765
