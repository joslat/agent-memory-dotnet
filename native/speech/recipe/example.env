# Settings for recipe.sh. Copy this file somewhere private, fill it in, and keep it readable by you only: it holds the
# database password. recipe.sh writes the derived secret files next to it (STATE_DIR, default ./state).

# Images: built by build-images.sh, or by your own build from the same files.
SERVER_IMAGE=agentmemory-speech-server:local
SCHEMA_IMAGE=agentmemory-speech-schema:local

# The language model: any OpenAI-compatible chat-completions endpoint reachable from the speech server.
S2S_LLM_BASE_URL=http://host.docker.internal:11434/v1
S2S_LLM_MODEL=qwen3:4b

# Memory: off runs the plain server (no database, no AgentMemory library loaded); on adds Neo4j and recall.
MEMORY=on
# The one person this server remembers for: every recall (and, with MEMORY_WRITES=on, every write) is bound to this owner.
MEMORY_OWNER=change-me
# 12 or more of A-Z a-z 0-9 . _ ~ + -
NEO4J_PASSWORD=change-me-to-a-long-random-value
# The embedding endpoint that embedded the stored memories (same model and dimension), OpenAI-compatible.
EMBEDDING_URL=http://host.docker.internal:11434/v1/embeddings
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

# Memory writes (R1): off keeps memory read-only. On lets the owner say "remember that ..." and "forget what I just told
# you"; each request goes through the library's durable journal, and the robot says only what the receipt supports.
MEMORY_WRITES=off
# The model that turns the owner's words into memories (OpenAI-compatible chat completions); with MEMORY_WRITES=on.
# WRITER_URL=http://host.docker.internal:11434/v1/chat/completions
# WRITER_MODEL=qwen3:4b
# WRITER_TIMEOUT_MS=60000
# WRITER_API_KEY=...                 # only for a hosted endpoint; it stays in this file and the server's secret file
# JOURNAL_VOLUME=agentmemory-speech-journal
# Learning (R2), with MEMORY_WRITES=on: every write applied once in one store transaction, and the owner's told facts
# learned unasked (never questions, bare assent or greetings). MEMORY_OBSERVE=0 pauses learning unasked.
MEMORY_LEARNING=off
# MEMORY_OBSERVE=1

# Optional
# S2S_PUBLISH=0.0.0.0:8765          # where the server listens on the host (default 127.0.0.1:8765)
# MEMORY_DEADLINE_MS=450             # how long a turn may wait for its recall
# NEO4J_DATA_VOLUME=agentmemory-speech-neo4j
# SPEECH_CACHE_VOLUME=agentmemory-speech-cache
# COMPOSE_PROJECT=agentmemory-speech
