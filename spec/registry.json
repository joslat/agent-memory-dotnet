      "publisher",
      "curator",
      "assurer"
    ],
    "keys": [
      "publisher",
      "curator",
      "assurer",
      "revoker",
      "evaluator"
    ]
  },
  "federation": {
    "accessKinds": [
      "wac",
      "acp",
      "public"
    ]
  },
  "trial": {
    "fields": [
      "measure",
      "tasks",
      "baseline",
      "confidence",
      "targets",
      "upgrade"
    ],
    "targets": [
      "hitRate",
      "precision",
      "lift",
      "precisionLift",
      "addedP95Ms"
    ]
  },
  "certificate": {
    "measures": [
      "test-impact",
      "retrieval"
    ],
    "baselines": [
      "host",
      "none"
    ],
    "confidences": [
      900,
      950,
      975,
      990
    ]
  },
  "paths": {
    "deviceNames": [
      "CON",
      "PRN",
      "AUX",
      "NUL",
      "CONIN$",
      "CONOUT$",
      "COM1",
      "COM2",
      "COM3",
      "COM4",
      "COM5",
      "COM6",
      "COM7",
      "COM8",
      "COM9",
      "LPT1",
      "LPT2",
      "LPT3",
      "LPT4",
      "LPT5",
      "LPT6",
      "LPT7",
      "LPT8",
      "LPT9"
    ]
  },
  "profiles": {
    "walk": {
      "implemented": true,
      "files": [
        "traversal.json"
      ]
    },
    "trial": {
      "implemented": true,
      "files": [
        "evals/trial.json",
        "evals/tests.json"
      ]
    },
    "compose": {
      "implemented": true,
      "files": [
        "members.json",
        "META/lock.json"
      ],
      "fields": [
        "contains"
      ],
      "kinds": [
        "composite"
      ]
    },
    "federation": {
      "implemented": true,
      "extensions": [
        "federation"
      ]
    },
    "protection": {
      "implemented": false,
      "files": [
        "META/seal.json"
      ],
      "values": {
        "protection": [
          "audience",
          "licensed",
          "attested",
          "hosted"
        ]
      },
      "refusal": "{id} is protected as '{protection}'; this host opens 'open' packs only."
    },
    "code": {
      "implemented": false,
      "files": [
        "queries.json",
        "queries/",
        "components.json",
        "components/"
      ],
      "values": {
        "code": [
          "E1",
          "E2"
        ]
      },
      "refusal": "{id} carries code (tier {code}); this host runs declarative (E0) packs only."
    },
    "permissions": {
      "implemented": false,
      "files": [
        "policy.json"
      ],
      "refusal": "{id} carries a usage policy (policy.json); this host cannot enforce one yet, so it does not load the pack."
    }
  }
}
