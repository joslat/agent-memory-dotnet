# Squad: union merge for append-only team state files
.squad/decisions.md merge=union
.squad/agents/*/history.md merge=union
.squad/log/** merge=union
.squad/orchestration-log/** merge=union

# Squad CLI YAML frontmatter parser requires LF endings
loop.md text eol=lf

# Release scripts and the shell-read package inventory must survive Windows checkouts.
eng/*.sh text eol=lf
eng/release-packages.txt text eol=lf
