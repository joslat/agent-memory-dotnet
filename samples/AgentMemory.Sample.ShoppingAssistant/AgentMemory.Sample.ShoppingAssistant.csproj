<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.17.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <!--
    In-repo the sample references the projects directly. As a standalone / Microsoft Agent Framework
    contribution it would instead reference the published packages:
        dotnet add package AgentMemory
        dotnet add package AgentMemory.AgentFramework
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentMemory.AgentFramework\AgentMemory.AgentFramework.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Core\AgentMemory.Core.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Neo4j\AgentMemory.Neo4j.csproj" />
    <ProjectReference Include="..\AgentMemory.Samples.Shared\AgentMemory.Samples.Shared.csproj" />
  </ItemGroup>

</Project>
