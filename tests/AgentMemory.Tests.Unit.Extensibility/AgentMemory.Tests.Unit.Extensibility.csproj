<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The SDK is shipped [Experimental]; its own tests are the one place that is expected. -->
    <!-- AMEXT001: this SDK's own experimental marker; its tests are the one place that is expected.
         MAAI001: the Agent Framework marks InvokingContext's constructor evaluation-only. Constructing
         one is exactly what a provider test must do, and the alternative is not testing the seam. -->
    <NoWarn>$(NoWarn);AMEXT001;MAAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="FluentAssertions" Version="8.9.0" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <!-- The concrete container and logging, for the registration tests. The SDK itself references
         only the abstractions; a host brings the implementation, which is what these tests verify. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentMemory.Extensibility\AgentMemory.Extensibility.csproj" />
    <ProjectReference Include="../../src/AgentMemory.Extensibility.Neo4j/AgentMemory.Extensibility.Neo4j.csproj" />
    <!-- Test-only: verify refusal using the actual NAMS registration extension. -->
    <ProjectReference Include="../../src/AgentMemory.Nams/AgentMemory.Nams.csproj" />
    <!-- Test-only: pin reserved names to actual storage declarations. The SDK remains Abstractions-only. -->
    <ProjectReference Include="..\..\src\AgentMemory.Neo4j\AgentMemory.Neo4j.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Extensibility.AgentFramework\AgentMemory.Extensibility.AgentFramework.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Packs.Repository\AgentMemory.Packs.Repository.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Packs.CodeMap.Roslyn\AgentMemory.Packs.CodeMap.Roslyn.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Packs.Decisions\AgentMemory.Packs.Decisions.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Packs.Architecture\AgentMemory.Packs.Architecture.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Packs.Intent\AgentMemory.Packs.Intent.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Packs.Coding\AgentMemory.Packs.Coding.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Packs.Work\AgentMemory.Packs.Work.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Extensibility.Ampack\AgentMemory.Extensibility.Ampack.csproj" />
    <!-- PACK-tool-e2e: the ampack tool is run as a process; built first, not referenced. -->
    <ProjectReference Include="..\..\tools\Ampack\Ampack.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build a real implementation assembly, but never reference or load it into the test host. -->
    <ProjectReference Include="..\Fixtures\ModuleDiscoveryFixture\ModuleDiscoveryFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyModuleDiscoveryFixture" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)ModuleFixtures" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\Fixtures\ModuleDiscoveryFixture\bin\$(Configuration)\net10.0\ModuleDiscoveryFixture.dll" DestinationFolder="$(OutDir)ModuleFixtures" />
  </Target>
  <ItemGroup>
    <None Include="../../src/AgentMemory.Extensibility/Schemas/*.json" Link="ModuleSchemas/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../eng/trial-statistics/golden.json" Link="TrialStatistics/golden.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The shipped martial-arts pack's unsigned content, signed in memory by its test. -->
    <None Include="../../packs/AgentMemory.Packs.MartialArts/agentmemory/manifest.json" Link="Packs/MartialArts/manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../packs/AgentMemory.Packs.MartialArts/agentmemory/icon.png" Link="Packs/MartialArts/icon.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../packs/AgentMemory.Packs.MartialArts/agentmemory/seed/*.jsonl" Link="Packs/MartialArts/seed/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The code map's manifest as a file, for the definition-pack round trip (pack format v1.2). -->
    <None Include="../../src/AgentMemory.Packs.CodeMap/manifest.json" Link="Packs/CodeMap/manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/AgentMemory.Packs.Decisions/manifest.json" Link="Packs/Decisions/manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/AgentMemory.Packs.Work/manifest.json" Link="Packs/Work/manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/AgentMemory.Packs.Repository/manifest.json" Link="Packs/Repository/manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/AgentMemory.Packs.Coding/composite.json" Link="Packs/Coding/composite.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
