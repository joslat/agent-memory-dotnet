<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The SDK is shipped [Experimental]; its own tests are the one place that is expected. -->
    <!-- AMEXT001: this SDK's own experimental marker; its tests are the one place that is expected.
         MAAI001: the Agent Framework marks InvokingContext's constructor evaluation-only. Constructing
         one is exactly what a provider test must do, and the alternative is not testing the seam. -->
    <NoWarn>$(NoWarn);AMEXT001;MAAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="FluentAssertions" Version="8.9.0" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <!-- The concrete container and logging, for the registration tests. The SDK itself references
         only the abstractions; a host brings the implementation, which is what these tests verify. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentMemory.Extensibility\AgentMemory.Extensibility.csproj" />
    <!-- Test-only: pin reserved names to actual storage declarations. The SDK remains Abstractions-only. -->
    <ProjectReference Include="..\..\src\AgentMemory.Neo4j\AgentMemory.Neo4j.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Extensibility.AgentFramework\AgentMemory.Extensibility.AgentFramework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build a real implementation assembly, but never reference or load it into the test host. -->
    <ProjectReference Include="..\Fixtures\ModuleDiscoveryFixture\ModuleDiscoveryFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyModuleDiscoveryFixture" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)ModuleFixtures" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\Fixtures\ModuleDiscoveryFixture\bin\$(Configuration)\net10.0\ModuleDiscoveryFixture.dll" DestinationFolder="$(OutDir)ModuleFixtures" />
  </Target>
  <ItemGroup>
    <None Include="../../src/AgentMemory.Extensibility/Schemas/*.json" Link="ModuleSchemas/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
