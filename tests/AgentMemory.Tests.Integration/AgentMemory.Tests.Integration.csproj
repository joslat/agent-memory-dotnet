<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="FluentAssertions" Version="8.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.9" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.23.0" />
    <PackageReference Include="Microsoft.Agents.AI.Abstractions" Version="1.23.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Neo4j.Driver" Version="6.3.0" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="Testcontainers.Neo4j" Version="4.15.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AgentMemory.Extensibility.AgentFramework/AgentMemory.Extensibility.AgentFramework.csproj" />
    <ProjectReference Include="../../src/AgentMemory.Extensibility.Neo4j/AgentMemory.Extensibility.Neo4j.csproj" />
    <ProjectReference Include="../../src/AgentMemory.Packs.CodeMap/AgentMemory.Packs.CodeMap.csproj" />
    <ProjectReference Include="../../src/AgentMemory.Packs.Work/AgentMemory.Packs.Work.csproj" />
    <ProjectReference Include="../../src/AgentMemory.Packs.Architecture/AgentMemory.Packs.Architecture.csproj" />
    <ProjectReference Include="../../src/AgentMemory.Packs.Decisions/AgentMemory.Packs.Decisions.csproj" />
    <ProjectReference Include="../../src/AgentMemory.Packs.Intent/AgentMemory.Packs.Intent.csproj" />
    <ProjectReference Include="../../src/AgentMemory.Packs.Repository/AgentMemory.Packs.Repository.csproj" />
    <ProjectReference Include="../../src/AgentMemory.Packs.Coding/AgentMemory.Packs.Coding.csproj" />
    <ProjectReference Include="../../src/AgentMemory.Extensibility.Ampack/AgentMemory.Extensibility.Ampack.csproj" />
    <ProjectReference Include="../../tools/AgentMemory.Cli/AgentMemory.Cli.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../samples/AgentMemory.Sample.CopilotAgent/AgentMemory.Sample.CopilotAgent.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\AgentMemory\AgentMemory.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Neo4j\AgentMemory.Neo4j.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Analytics\AgentMemory.Analytics.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Core\AgentMemory.Core.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Abstractions\AgentMemory.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.McpServer\AgentMemory.McpServer.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.AgentFramework\AgentMemory.AgentFramework.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.AgentFramework.Nams\AgentMemory.AgentFramework.Nams.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Nams\AgentMemory.Nams.csproj" />
    <ProjectReference Include="..\..\src\AgentMemory.Validation\AgentMemory.Validation.csproj" />
    <ProjectReference Include="..\..\tools\AgentMemory.TckBridge\AgentMemory.TckBridge.csproj" />
    <ProjectReference Include="..\..\tools\AgentMemory.RouterArena\AgentMemory.RouterArena.csproj" Aliases="RouterArena" />
    <ProjectReference Include="..\..\tools\AgentMemory.McpHost\AgentMemory.McpHost.csproj" Aliases="McpHost" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Fixtures/ModuleMigrationFixture/ModuleMigrationFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- PACK-e2e: the real packs, built into .ampack files by the tests. -->
  <ItemGroup>
    <None Include="../../packs/AgentMemory.Packs.MartialArts/agentmemory/manifest.json" Link="Packs/MartialArts/manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../packs/AgentMemory.Packs.MartialArts/agentmemory/icon.png" Link="Packs/MartialArts/icon.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../packs/AgentMemory.Packs.MartialArts/agentmemory/seed/*.jsonl" Link="Packs/MartialArts/seed/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/AgentMemory.Packs.CodeMap/manifest.json" Link="Packs/CodeMap/manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/AgentMemory.Packs.Decisions/manifest.json" Link="Packs/Decisions/manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/AgentMemory.Packs.Work/manifest.json" Link="Packs/Work/manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/AgentMemory.Packs.Repository/manifest.json" Link="Packs/Repository/manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/AgentMemory.Packs.Coding/composite.json" Link="Packs/Coding/composite.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyModuleMigrationFixture" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)ModuleFixtures" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../Fixtures/ModuleMigrationFixture/fixture.agentmemory-module.json" DestinationFolder="$(OutDir)ModuleFixtures" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../Fixtures/ModuleMigrationFixture/bin/$(Configuration)/net10.0/ModuleMigrationFixture.dll" DestinationFolder="$(OutDir)ModuleFixtures" />
  </Target>
</Project>
